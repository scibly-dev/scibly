{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "noUncheckedIndexedAccess": false,
    "lib": ["ES2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node", "react"],
    "paths": {
      "@/*": ["../../apps/app/src/*"],
      "@test/*": ["../../apps/app/__test__/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "__test__/**/*.ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["node_modules"]
}
