  "spot_emails/urgent_email": {
    "learnerContent": {
      "type": "doc",
      "content": [
        {
          "type": "custom-guide-character",
          "attrs": {
            "id": null,
            "isEditable": "default",
            "isQuestionBlock": false,
            "isResizable": false,
            "character": "buddy",
            "layout": "left"
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "📧 An email just landed. Read it once, then we decide together. 👀"
                }
              ]
            }
          ]
        },
        {
          "type": "blockquote",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "marks": [{ "type": "bold" }],
                  "text": "Subject:"
                },
                { "type": "text", "text": " Your mailbox is full" }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                { "type": "text", "text": "Confirm your password " },
                {
                  "type": "text",
                  "marks": [{ "type": "italic" }],
                  "text": "now"
                },
                {
                  "type": "text",
                  "text": " or it will be locked within one hour."
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Sounds urgent, right? That rush feeling is often the trap."
            }
          ]
        }
      ]
    },
    "gradingManifest": []
  },
  "spot_emails/pause_before_click": {
    "learnerContent": {
      "type": "doc",
