              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "It does not come from a channel you already trust"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The everyday name for this kind of fake, urgent message is "
            },
            {
              "type": "custom-input-field",
              "attrs": {
                "id": "spot_emails-name_the_threat-q-1",
                "isEditable": "default",
                "isQuestionBlock": true,
                "isResizable": false,
                "questionBlockAttributes": {
                  "optional": false,
                  "questionData": { "answer": "X", "caseSensitive": false },
                  "userAnswers": "",
