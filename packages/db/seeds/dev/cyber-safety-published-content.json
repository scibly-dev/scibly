        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "In two or three sentences, when would you pause and ask for help before clicking a link?"
            }
          ]
        },
        {
          "type": "custom-free-form-input",
          "attrs": {
            "id": "protect_login-when_to_ask_it-q-1",
            "isEditable": "default",
            "isQuestionBlock": true,
            "isResizable": false,
