  "spot_emails/name_the_threat": {
    "learnerContent": {
      "type": "doc",
      "content": [
        {
          "type": "custom-guide-character",
          "attrs": {
            "id": null,
            "isEditable": "default",
            "isQuestionBlock": false,
            "isResizable": false,
