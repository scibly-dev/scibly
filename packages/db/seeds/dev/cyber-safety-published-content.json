  "spot_emails/what_first": {
    "learnerContent": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "text": "You get an email that " },
            {
              "type": "text",
              "marks": [{ "type": "italic" }],
              "text": "looks"
            },
            {
              "type": "text",
              "text": " like it is from IT. It says your account will be closed in one hour unless you click a link and sign in."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "text": "✅ What do you do " },
            { "type": "text", "marks": [{ "type": "bold" }], "text": "first" },
            { "type": "text", "text": "?" }
          ]
        },
        {
          "type": "custom-multiple-choice",
          "attrs": {
            "id": "spot_emails-what_first-q-1",
            "isEditable": "default",
            "isQuestionBlock": true,
            "isResizable": false,
            "questionBlockAttributes": {
              "optional": false,
              "questionData": {
                "choices": [
                  {
                    "id": "c1",
                    "text": "Click the link quickly so your account stays open"
                  },
                  {
                    "id": "c2",
                    "text": "Contact IT using a known phone number or ticket system"
                  },
                  {
                    "id": "c3",
                    "text": "Reply with your password so they can fix it"
                  },
                  {
                    "id": "c4",
                    "text": "Forward the email to a teammate and ask them to try first"
                  }
                ],
                "correctChoiceIds": [],
                "allowMultiple": false
              },
              "userAnswers": [],
              "sp": 15
            }
          }
        }
      ]
    },
