                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Does it push you to act in minutes?"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Did you expect this message at all?"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "custom-inline-hint",
                      "attrs": {
                        "id": null,
                        "isEditable": "default",
                        "isQuestionBlock": false,
                        "isResizable": false,
                        "content": "Pause first. Urgency is often the trap.",
                        "isRevealed": false,
                        "learnerRevealed": false
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "gradingManifest": []
  },
  "spot_emails/what_is_phishing": {
    "learnerContent": {
      "type": "doc",
      "content": [
        {
          "type": "custom-guide-character",
          "attrs": {
            "id": null,
            "isEditable": "default",
