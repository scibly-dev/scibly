            "layout": "top"
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Quick flip card. Think of that urgent mailbox email. 🧠"
                }
              ]
            }
          ]
        },
        {
          "type": "flashcard",
          "attrs": {
            "id": null,
            "isEditable": "default",
            "isQuestionBlock": false,
            "isResizable": false,
            "theme": "default"
          },
          "content": [
            {
              "type": "flashcardFace",
              "attrs": { "position": "front" },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    { "type": "text", "text": "What do we call a " },
                    {
                      "type": "text",
                      "marks": [{ "type": "bold" }],
                      "text": "fake message"
                    },
                    {
                      "type": "text",
                      "text": " that tries to steal a password or push a risky link?"
                    }
                  ]
                }
              ]
            },
            {
              "type": "flashcardFace",
              "attrs": { "position": "back" },
              "content": [
                {
                  "type": "paragraph",
