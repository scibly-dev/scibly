          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Type the everyday name for that trick. Spelling can be lowercase. ✍️"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "A colleague forwards you a rushed message that asks people to confirm their work password on a strange website."
