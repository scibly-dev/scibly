                      "alignment": "center"
                    }
                  }
                }
              ]
            },
            {
              "type": "column",
              "attrs": { "position": "right" },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    { "type": "text", "text": "🔒 Before you click, check:" }
                  ]
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
