/// The language a topic's document is written in. Lower-cased to match the
/// `Locale` the app already passes around, so no mapping is needed either way.
enum KnowledgeTopicLanguage {
  en
  de

  @@map("knowledge_topic_language")
}

/// One living document: what it is about, which repositories it watches, and
/// who reviews what the sync proposes for it.
model KnowledgeTopic {
  id                 String                 @id @default(cuid())
  organizationId     String
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  /// What the topic is about, in the maintainer's own words. A name alone tells
  /// the triage model nothing to judge a pull request against; this is what it
  /// reads. Optional, because scope is settled structurally either way.
  description        String                 @default("")
  /// `{ id, fullName, pathGlobs }[]`, resolved from the GitHub installation at
  /// write time: the id survives a rename, the name is what a maintainer reads,
  /// and the globs narrow that one repository — empty means all of it.
  repositories       Json
  language           KnowledgeTopicLanguage
  /// The canonical document; Notion holds a projection, never the other way round.
  markdown           String                 @default("")
  /// Deleting the topic leaves the page: documents belong to the organization.
  notionPageId       String?
  notionRevisionAt   DateTime?
  /// Of the markdown last published, so a later synthesis can tell a real change from a re-save.
  documentHash       String?
  publishedAt        DateTime?
  /// When the page's revision was last compared against `notionRevisionAt`.
  verifiedAt         DateTime?
  /// A revision this side did not write; a flagged document is never overwritten.
  externallyEditedAt DateTime?
  /// Members, not users: someone who leaves the organization stops maintaining.
  maintainers        Member[]               @relation("KnowledgeTopicMaintainers")
  insights           KnowledgeInsight[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([organizationId, name])
  @@map("knowledge_topic")
}

/// Why the structural filter refused a pull request. Kept on the discarded row
/// so the counts in a feed can be explained and the thresholds tuned against
/// what actually happened rather than against a guess.
enum KnowledgeDiscardReason {
  BOT_AUTHOR
  CHORE_TITLE
  NO_DISCUSSION
  LOW_DENSITY

  @@map("knowledge_discard_reason")
}

enum KnowledgeCollectionRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@map("knowledge_collection_run_status")
}

/// One repository's turn at collecting, for one organization. Also the
/// watermark: the newest run that succeeded says how far collection has got,
/// so a failed run cannot advance it.
///
/// A partial unique index — (organizationId, repositoryId) WHERE status =
/// 'QUEUED' — guards against stacking waiting turns. Prisma cannot express it;
/// it lives in the migration SQL only. Keep the two in step by hand.
model KnowledgeCollectionRun {
  id                 String                       @id @default(cuid())
  organizationId     String
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryId       String
  status             KnowledgeCollectionRunStatus @default(QUEUED)
  /// Written by the trigger, before the worker has picked the run up.
  startedAt          DateTime                     @default(now())
  finishedAt         DateTime?
  collected          Int                          @default(0)
  discarded          Int                          @default(0)
  /// How recently a pull request had to have been touched to be seen by this
  /// run. Only ever read off a SUCCEEDED run — that is what makes the watermark
  /// advance on success alone.
  collectedThrough   DateTime?
  /// The run stopped on its detail budget, not on running out of pull requests.
  /// The next run continues from `collectedThrough`.
  capped             Boolean                      @default(false)
  /// GitHub's own message, never a credential — see the provider's error handling.
  failureReason      String?

  @@index([organizationId, repositoryId, status, startedAt], map: "knowledge_collection_run_org_repo_status_idx")
  @@map("knowledge_collection_run")
}

/// One merged pull request worth learning from, held for the organization
/// against the repository it came from — never for one topic, since the same
/// pull request feeds every topic watching that repository.
model KnowledgeBundle {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryId   String
  /// GitHub's node id for the pull request. With the repository it is what
  /// makes a re-run a no-op.
  externalId     String
  number         Int
  /// GitHub's `updatedAt`, which is what the watermark is measured in.
  githubUpdatedAt DateTime
  /// Null on a discarded row: nothing about a refused pull request is kept
  /// beyond what proves it was judged.
  mergedAt       DateTime?
  /// The structural filter's discussion-density score. Set on a survivor, and
  /// on a LOW_DENSITY discard so the threshold can be tuned against real numbers.
  score          Int?
  /// Set exactly when `content` is null.
  discardReason  KnowledgeDiscardReason?
  /// `{ title, body, labels, filePaths, linkedIssues, threads }` — sanitized and
  /// token-capped before it is written. Pruned back to null by the extraction
  /// stage once the bundle has been read.
  content        Json?
  /// What the feed shows, lifted out of `content` so reading it never means
  /// hauling the whole conversation. Null exactly when `content` is.
  title          String?
  url            String?
  filePaths      String[]                @default([])
  /// The token cap dropped something, so nothing downstream may claim the
  /// bundle is the whole conversation.
  truncated      Boolean                 @default(false)
  collectedAt    DateTime                @default(now())
  /// Where the funnel left the bundle. Set with `processedAt` on a terminal
  /// outcome; set alone when the funnel stopped short and will try again.
  outcome        KnowledgeBundleOutcome?
  /// Why the funnel stopped, set only alongside a `FAILED` outcome. The
  /// provider's own message, truncated — never a credential.
  failureReason  String?
  /// The funnel is done with it: `content` is pruned in the same write, and
  /// only what proves the bundle was judged survives. A pull request that moves
  /// on GitHub is re-collected, which clears this and puts it back in the funnel.
  processedAt    DateTime?
  insights       KnowledgeInsight[]

  @@unique([organizationId, repositoryId, externalId], map: "knowledge_bundle_org_repo_external_key")
  @@index([organizationId, repositoryId, collectedAt], map: "knowledge_bundle_org_repo_collected_idx")
  /// Finds what the funnel never finished — a dropped event, an organization
  /// that ran out of credits — so the nightly retry can pick it up.
  @@index([organizationId, processedAt, collectedAt], map: "knowledge_bundle_org_unprocessed_idx")
  @@map("knowledge_bundle")
}

/// Where the funnel left a bundle. Every value but `UNFUNDED` is terminal.
enum KnowledgeBundleOutcome {
  /// No topic watches what this pull request touched.
  OFF_TOPIC
  /// Triage scored it below the documentation-worthiness threshold.
  LOW_VALUE
  /// Extraction ran and at least one claim cleared the confidence floor.
  EXTRACTED
  /// Extraction ran and everything it produced fell below the floor.
  NO_INSIGHTS
  /// The organization could not pay for the extraction. Not terminal: the
  /// content is kept and the nightly retry sends it round again.
  UNFUNDED
  /// Triage or extraction exhausted its retries. Not terminal either, and the
  /// only outcome that carries `failureReason` — a stopped funnel is not a
  /// verdict, so the content is kept and the nightly retry sends it round again.
  FAILED

  @@map("knowledge_bundle_outcome")
}

/// Where a claim is in its life. Only `PROPOSED` is written here; the review
/// queue moves it on.
enum KnowledgeInsightStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  SUPERSEDED

  @@map("knowledge_insight_status")
}

/// One durable claim, re-authored out of a pull request's argument and filed
/// against the topic it belongs to. Deliberately untyped: a decision, a
/// convention and a gotcha are all just claims that cite where they came from.
model KnowledgeInsight {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  topicId        String
  topic          KnowledgeTopic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  /// The bundle it was read out of. Nulled rather than cascaded, so a claim
  /// outlives the pull request row it came from.
  bundleId       String?
  bundle         KnowledgeBundle?       @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  /// Prose the extraction wrote, never a quote of the conversation.
  claim          String
  /// `{ url, label }[]`, at least one, every url checked against the bundle
  /// before it was written — a model cannot invent a link into this column.
  citations      Json
  /// 0-100, as the extraction judged it. Below the floor it is never stored.
  confidence     Int
  status         KnowledgeInsightStatus @default(PROPOSED)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([topicId, status, createdAt(sort: Desc)], map: "knowledge_insight_topic_status_idx")
  @@map("knowledge_insight")
}
