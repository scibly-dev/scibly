enum SceneVibe {
  NEUTRAL
  URGENT
  CALM
  PLAYFUL
}

enum SceneAnimation {
  FADE
  SLIDE_UP
  SCALE
  BLUR
}

enum SceneOutdatedReason {
  SOURCE_CHANGED
  SOURCE_REMOVED

  @@map("scene_outdated_reason")
}

model Scene {
  id String @id @default(cuid())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order    Int    @default(0)

  title       String         @default("New Scene")
  vibe        SceneVibe      @default(NEUTRAL)
  animation   SceneAnimation @default(FADE)
  integration Json?

  /// Collaborative authoring state. Never returned by learner APIs.
  documentState   Bytes?
  /// Solution-sanitized TipTap JSON; this is what learners are served.
  learnerContent  Json?
  /// Answer key, frozen with learnerContent at publish time.
  gradingManifest Json?
  /// True when gradingManifest contains question blocks.
  hasQuestions    Boolean              @default(false)
  /// Basis SP + question-block SP, at publish time.
  maxSp           Int?
  sp              Int                  @default(0)
  /// Draft scenes only.
  isOutdated      Boolean              @default(false)
  /// Null exactly when isOutdated is false.
  outdatedReason  SceneOutdatedReason?

  // Set on a published copy; null on a draft scene.
  courseVersionId String?
  courseVersion   CourseVersion? @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  sourceSceneId   String?
  sourceScene     Scene?         @relation("SceneSource", fields: [sourceSceneId], references: [id], onDelete: SetNull)
  publishedCopies Scene[]        @relation("SceneSource")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sceneProgresses SceneProgress[]
  sceneAnalytics  SceneAnalytics[]
  sourceLineages  SceneSourceLineage[]

  @@index([lessonId])
  @@index([courseVersionId])
  @@index([sourceSceneId])
  // Partial index `scene_outdated_draft_idx` (WHERE isOutdated AND courseVersionId IS NULL) exists via raw migration; the DSL cannot express it.
  @@map("scene")
}

model SceneSourceLineage {
  id        String         @id @default(cuid())
  sceneId   String
  scene     Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sourceId  String
  source    NotebookSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([sceneId, sourceId])
  @@index([sourceId])
  @@index([sceneId])
  @@map("scene_source_lineage")
}
