/// DOCUMENT is the tiptap-edited scene every learner has seen so far. PRACTICE
/// is an agent-generated interactive mini-app, graded against a stored
/// solution instead of question blocks — see docs/plans/practice-scenes.md.
enum SceneKind {
  DOCUMENT
  PRACTICE
}

enum SceneVibe {
  NEUTRAL
  URGENT
  CALM
  PLAYFUL
}

enum SceneAnimation {
  FADE
  SLIDE_UP
  SCALE
  BLUR
}

/// Why a draft scene was flagged as outdated. The author needs to tell
/// "the source moved on" from "the source is gone" — the second cannot be
/// resolved by re-reading the source.
enum SceneOutdatedReason {
  SOURCE_CHANGED
  SOURCE_REMOVED

  @@map("scene_outdated_reason")
}

model Scene {
  id String @id @default(cuid())

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order    Int    @default(0)

  title       String         @default("New Scene")
  kind        SceneKind      @default(DOCUMENT)
  vibe        SceneVibe      @default(NEUTRAL)
  animation   SceneAnimation @default(FADE)
  integration Json?

  /// Collaborative authoring state. Never returned by learner APIs. DOCUMENT scenes only.
  documentState   Bytes?
  /// PRACTICE draft: the agent's HTML fragment. Assembled into a full document at render time — see docs/plans/practice-scenes.md.
  practiceHtml     String?
  /// PRACTICE draft: { field: { value, points, eps? } }, or absent for an open-ended practice.
  practiceSolution Json?
  /// PRACTICE draft: released to the learner on every submit, alongside any comparison result.
  practiceExplain  String?
  /// PRACTICE draft: sha256 of practiceHtml + practiceSolution as of the last
  /// passing self-test run. Publish re-derives the hash and refuses a mismatch,
  /// so editing either column retires the stamp without anything clearing it.
  practiceValidated String?
  /// Immutable, solution-sanitized TipTap JSON (DOCUMENT) or the app fragment (PRACTICE) rendered by learners.
  learnerContent  Json?
  /// Immutable answer key generated with learnerContent at publish time.
  gradingManifest Json?
  /// Published summary: true when gradingManifest contains question blocks.
  hasQuestions    Boolean              @default(false)
  /// Maximum achievable SP (basis SP + question-block SP) at publish time.
  maxSp           Int?
  sp              Int                  @default(0)
  /// True when a cited source has changed since this scene was generated (draft scenes only).
  isOutdated      Boolean              @default(false)
  /// Why the flag was raised. Null exactly when isOutdated is false.
  outdatedReason  SceneOutdatedReason?

  // Set when this is a published copy belonging to a version; null for draft scenes
  courseVersionId String?
  courseVersion   CourseVersion? @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  // Original draft scene this was copied from; null for draft scenes
  sourceSceneId   String?
  sourceScene     Scene?         @relation("SceneSource", fields: [sourceSceneId], references: [id], onDelete: SetNull)
  publishedCopies Scene[]        @relation("SceneSource")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sceneProgresses SceneProgress[]
  sceneAnalytics  SceneAnalytics[]
  sourceLineages  SceneSourceLineage[]

  @@index([lessonId])
  @@index([courseVersionId])
  @@index([sourceSceneId])
  // INV-12: partial index `scene_outdated_draft_idx` (WHERE isOutdated AND
  // courseVersionId IS NULL) exists via raw migration — Prisma's schema DSL
  // cannot express partial indexes, so it isn't declared here.
  @@map("scene")
}

model SceneSourceLineage {
  id        String         @id @default(cuid())
  sceneId   String
  scene     Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sourceId  String
  source    NotebookSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([sceneId, sourceId])
  @@index([sourceId])
  @@index([sceneId])
  @@map("scene_source_lineage")
}
