/// Exactly one of enrollmentId / anonymousSessionId is set.
model SceneAnalytics {
  id String @id @default(cuid())

  enrollmentId String?
  enrollment   CourseEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  anonymousSessionId String?
  anonymousSession   AnonymousCourseSession? @relation(fields: [anonymousSessionId], references: [id], onDelete: SetNull)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sceneId  String
  scene    Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  spEarned    Int      @default(0)
  completedAt DateTime @default(now())

  /// [{ blockId, blockType, learnerAnswer, achievedPoints, maxPoints, spEarned }]
  gradedBlocks Json?

  attempt Int @default(1)

  createdAt DateTime @default(now())

  @@unique([enrollmentId, lessonId, sceneId, attempt])
  @@unique([anonymousSessionId, lessonId, sceneId, attempt])
  @@index([enrollmentId])
  @@index([anonymousSessionId])
  @@index([sceneId])
  @@index([lessonId])
  @@map("scene_analytics")
}
