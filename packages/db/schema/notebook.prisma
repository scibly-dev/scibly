enum NotebookSourceType {
  PDF
  TEXT
  NOTION_PAGE

  @@map("notebook_source_type")
}

enum NotebookSourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED

  @@map("notebook_source_status")
}

enum ChatRole {
  USER
  ASSISTANT

  @@map("chat_role")
}

model Notebook {
  id                          String                   @id @default(cuid())
  title                       String
  organizationId              String
  organization                Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                      String
  user                        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId                    String?
  course                      Course?                  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  promptTemplateId            String?
  promptTemplate              PromptTemplate?          @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  /// Stands in for every message up to `chatSummaryThroughMessageId` in the model's context; the stored chat keeps every message.
  chatSummary                 String?                  @db.Text
  chatSummaryThroughMessageId String?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  sources                     NotebookSource[]
  generatedImages             NotebookGeneratedImage[]
  chats                       NotebookChat[]
  creditLedgerEntries         CreditLedgerEntry[]

  @@index([organizationId])
  @@index([userId])
  @@index([courseId])
  @@index([promptTemplateId])
  @@map("notebook")
}

model NotebookSource {
  id                  String               @id @default(cuid())
  notebookId          String
  notebook            Notebook             @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  name                String
  type                NotebookSourceType
  url                 String? // S3 key
  content             String? // Full extracted text, inlined verbatim into the chat prompt
  /// Estimated model tokens for `content` (chars / 4). 0 means the row predates full-text storage and its `content` is still the old 10k-char truncation.
  tokenCount          Int                  @default(0)
  /// In the source's own language: what it covers and is for.
  summary             String?
  /// In the source's own language: flat list of its sections.
  outline             String?
  status              NotebookSourceStatus @default(PENDING)
  error               String?
  warning             String?
  fileSize            Int? // bytes
  pageCount           Int?
  externalId          String?
  externalUrl         String?
  /// FK to IntegrationConnection, nullable so sources survive a disconnected integration.
  integrationId       String?
  lastSyncedAt        DateTime?
  /// SHA-256 of the extracted text, first 16 hex chars.
  contentHash         String?
  /// Set by the freshness poll, cleared by the ingestion that opening the notebook triggers; the poll never extracts.
  staleAt             DateTime?
  /// Lease start; once it expires the source is retryable by the normal awaited ingestion.
  processingStartedAt DateTime?
  /// Fencing token: every write a run makes is conditional on it, so a run whose claim was taken over lands nothing.
  processingToken     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sceneLineages       SceneSourceLineage[]

  @@unique([notebookId, integrationId, externalId])
  @@index([notebookId])
  // Without this the freshness poll sequentially scans the largest table in the product, once per connection per run.
  @@index([integrationId, status])
  @@map("notebook_source")
}

model NotebookGeneratedImage {
  id          String   @id @default(cuid())
  notebookId  String
  notebook    Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  prompt      String
  alt         String
  s3Key       String
  width       Int?
  height      Int?
  byteSize    Int
  aspectRatio String?
  toolCallId  String?
  createdAt   DateTime @default(now())

  @@unique([notebookId, toolCallId])
  @@index([notebookId, createdAt(sort: Desc)])
  @@map("notebook_generated_image")
}

model NotebookChat {
  id         String   @id @default(cuid())
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  role       ChatRole
  parts      Json
  createdAt  DateTime @default(now())

  @@index([notebookId, createdAt(sort: Desc)])
  @@map("notebook_chat")
}

model PromptTemplate {
  id             String        @id @default(cuid())
  name           String
  description    String
  systemPrompt   String
  organizationId String? // null = global preset
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  notebooks      Notebook[]

  @@index([organizationId])
  @@map("prompt_template")
}

enum OrganizationAIModelType {
  CHAT
  /// Inert: the embedding pipeline is gone, and the value stays only because dropping it would rewrite the type.
  EMBEDDING
  IMAGE

  @@map("organization_ai_model_type")
}

enum OrganizationAIModelTestStatus {
  OK
  FAILED

  @@map("organization_ai_model_test_status")
}

model OrganizationAIModel {
  id              String                         @id @default(cuid())
  organizationId  String
  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            OrganizationAIModelType        @default(CHAT)
  name            String
  /// Must be OpenAI-compatible.
  baseUrl         String
  /// Never returned to the client.
  apiKeyEncrypted String
  modelId         String
  description     String?
  /// Asked for, because a self-hosted endpoint cannot be introspected; null means the conservative default.
  contextWindow   Int?
  /// IMAGE only; a CHAT row is chosen by `organizationsAsDefault` or by id, so nothing reads this flag for one.
  isActive        Boolean                        @default(true)
  lastTestStatus  OrganizationAIModelTestStatus?
  lastTestedAt    DateTime?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  organizationsAsDefault Organization[] @relation("OrgDefaultChatModel")

  @@index([organizationId])
  @@map("organization_ai_model")
}
