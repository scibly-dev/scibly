model Course {
  id                String                   @id @default(cuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  /// A LESSON course holds exactly one lesson and opens directly into it.
  mode              CourseMode               @default(COURSE)
  category          String?
  tags              String[]                 @default([])
  description       String?
  thumbnail         String?
  /// 0-100; null = no minimum score for a certificate.
  passingScorePct   Int?
  /// null = unlimited.
  maxTries          Int?
  allowAnonymous    Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  lessons           Lesson[]
  enrollments       CourseEnrollment[]
  versions          CourseVersion[]
  anonymousSessions AnonymousCourseSession[]
  notebooks         Notebook[]

  @@index([organizationId])
  @@map("course")
}
