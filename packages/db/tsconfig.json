{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "seeds/**/*.ts",
    "scripts/**/*.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules"]
}
