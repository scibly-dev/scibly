{
  "name": "@scibly/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview": "next build && next start",
    "i18n:merge": "pnpm --filter @scibly/api run i18n:merge-api && tsx scripts/merge-i18n.ts",
    "schema:generate": "tsx scripts/generate-editor-schema.ts",
    "prebuild": "pnpm i18n:merge && pnpm schema:generate",
    "predev": "pnpm i18n:merge && pnpm schema:generate",
    "build": "next build",
    "db:push": "dotenv-flow -e .env -- pnpm --filter @scibly/db run push",
    "db:seed": "dotenv-flow -e .env -- pnpm --filter @scibly/db run seed",
    "db:studio": "dotenv-flow -e .env -- pnpm --filter @scibly/db run studio",
    "migrate": "dotenv-flow -e .env -- pnpm --filter @scibly/db run migrate",
    "dev": "next dev --turbo --port 3001 --hostname 0.0.0.0",
    "dev:db": "concurrently --raw \"pnpm dev\" \"pnpm db:studio\"",
    "dev:email": "email dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "typecheck": "pnpm exec tsc --noEmit",
    "start": "next start --port 3001",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --workers 1 --pass-with-no-tests",
    "test:e2e:install": "playwright install",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm test && pnpm test:e2e"
  },
