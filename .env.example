# Copy to ".env" and fill in. Used by docker-compose.yml — see docs/docker.md
# for the full walkthrough (docs/setup.md covers the non-Docker/pnpm path).

# ── Database ──────────────────────────────────────────────────────────────
# The postgres container is created with these; DATABASE_URL for app/web/
# collab is derived from them automatically in docker-compose.yml.
POSTGRES_USER="scibly"
POSTGRES_PASSWORD="scibly"
POSTGRES_DB="scibly"

# ── Required secrets ─────────────────────────────────────────────────────
# Generate both with: openssl rand -base64 32
# COLLAB_TOKEN_SECRET signs the short-lived token each editor session uses to
# open a collab room — must be identical for the app and collab containers,
# which this compose file guarantees by sharing one .env. Minimum 32 chars.
COLLAB_TOKEN_SECRET=""
# Used by better-auth (apps/web, and as apps/app's fallback if
# COLLAB_TOKEN_SECRET is unset). Minimum 32 chars.
BETTER_AUTH_SECRET=""

# ── Public URLs ───────────────────────────────────────────────────────────
# Baked into the client bundle at *build* time (`docker compose build`), not
# read again at runtime — re-run `docker compose build` after changing these.
# Defaults below match the compose file's port mapping for a local run.
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:4000"
NEXT_PUBLIC_DOCS_URL="http://localhost:3000/docs"
NEXT_PUBLIC_ENV="production"

# Collaboration server (defaults are fine for most deployments).
COLLAB_PORT="4000"
COLLAB_TRUST_PROXY="false"

# ── Optional integrations ────────────────────────────────────────────────
# With SKIP_ENV_VALIDATION=true (default here), every var below can stay
# blank — the apps boot fine, but the feature behind a missing credential
# (Google sign-in, transactional email, media uploads, billing, Notion
# import, AI course generation, ...) won't work until it's supplied. Set
# SKIP_ENV_VALIDATION=false once every var your deployment needs is filled
# in. See docs/setup.md's "Optional integrations" for what each one powers.
SKIP_ENV_VALIDATION="true"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
RESEND_API_KEY=""

AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
MEDIA_BUCKET_NAME=""

NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

AI_GATEWAY_API_KEY=""
OPENAI_API_KEY=""
# 64 hex chars (32 bytes) — encrypts BYOAI API keys. Generate with:
# openssl rand -hex 32
ENCRYPTION_KEY=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_BUSINESS=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_TOPUP_SMALL=""
STRIPE_PRICE_TOPUP_LARGE=""
STRIPE_PRICE_SEAT_STARTER=""
STRIPE_PRICE_SEAT_BUSINESS=""
STRIPE_PRICE_SEAT_PRO=""
STRIPE_PORTAL_CONFIGURATION_ID=""

# Bearer token for /api/cron/* (apps/app). Generate with: openssl rand -hex 32
CRON_SECRET=""

NEXT_PUBLIC_POSTHOG_ENABLED="false"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
